{
  "name": "@serendipity/db",
  "version": "0.0.0",
  "private": true,
  "description": "Database migrations (infra/migrations) and their tests against PostgreSQL + PostGIS + pgvector.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./audit": {
      "types": "./src/audit.ts",
      "default": "./src/audit.ts"
    },
    "./consent": {
      "types": "./src/consent.ts",
      "default": "./src/consent.ts"
    },
    "./migration-status": {
      "types": "./src/migration-status.ts",
      "default": "./src/migration-status.ts"
    },
    "./test-db": {
      "types": "./src/test-db.ts",
      "default": "./src/test-db.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@serendipity/consent": "0.0.0",
    "@serendipity/domain": "0.0.0",
    "@serendipity/fixtures": "0.0.0",
    "@serendipity/redact": "0.0.0"
  }
}
