{
  "name": "@serendipity/db",
  "version": "0.0.0",
  "private": true,
  "description": "Database migrations (infra/migrations) and their tests against PostgreSQL + PostGIS + pgvector.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./audit": {
      "types": "./src/audit.ts",
      "default": "./src/audit.ts"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "default": "./src/auth.ts"
    },
    "./consent": {
      "types": "./src/consent.ts",
      "default": "./src/consent.ts"
    },
    "./identity": {
      "types": "./src/identity.ts",
      "default": "./src/identity.ts"
    },
    "./invitations": {
      "types": "./src/invitations.ts",
      "default": "./src/invitations.ts"
    },
    "./profile": {
      "types": "./src/profile.ts",
      "default": "./src/profile.ts"
    },
    "./recall": {
      "types": "./src/recall.ts",
      "default": "./src/recall.ts"
    },
    "./migration-status": {
      "types": "./src/migration-status.ts",
      "default": "./src/migration-status.ts"
    },
    "./test-db": {
      "types": "./src/test-db.ts",
      "default": "./src/test-db.ts"
    },
    "./test-invitations": {
      "types": "./src/test-invitations.ts",
      "default": "./src/test-invitations.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@serendipity/auth": "0.0.0",
    "@serendipity/consent": "0.0.0",
    "@serendipity/domain": "0.0.0",
    "@serendipity/fixtures": "0.0.0",
    "@serendipity/identity": "0.0.0",
    "@serendipity/invitations": "0.0.0",
    "@serendipity/matching": "0.0.0",
    "@serendipity/media": "0.0.0",
    "@serendipity/privacy": "0.0.0",
    "@serendipity/profile": "0.0.0",
    "@serendipity/redact": "0.0.0",
    "@serendipity/vision": "0.0.0"
  }
}
